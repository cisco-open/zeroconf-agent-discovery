+
+/// zeroconf-agent-discovery: servers that the discovery extension contributed
+/// are listed apart, without a tool count; their names don't matter.
+#[test]
+fn mcp_inventory_lists_discovered_servers_apart() {
+    use McpServerConnectionStatus as Status;
+
+    let status = |name: &str,
+                  runtime_status: Option<Status>,
+                  extension_id: Option<&str>,
+                  http_origin: Option<&str>| McpServerStatus {
+        server_capabilities: None,
+        tool_list_meta: None,
+        name: name.to_string(),
+        runtime_status,
+        plugin_id: None,
+        extension_id: extension_id.map(str::to_string),
+        http_origin: http_origin.map(str::to_string),
+        server_info: None,
+        tools: HashMap::new(),
+        tools_error: None,
+        resources: Vec::new(),
+        resource_templates: Vec::new(),
+        auth_status: McpAuthStatus::Unsupported,
+    };
+    let statuses = [
+        status("notes", Some(Status::Connected), None, None),
+        status(
+            "ietf-127-venue-guide_local",
+            None,
+            Some("zeroconf_discovery"),
+            Some("http://venue-guide-mac.local:8127"),
+        ),
+        status(
+            "calendar_local",
+            Some(Status::Disabled),
+            Some("zeroconf_discovery"),
+            None,
+        ),
+        // Configured, or from another extension: the normal list, whatever
+        // the name.
+        status("failing_local", Some(Status::Failed), None, None),
+        status("search", Some(Status::Connected), Some("web_search"), None),
+    ];
+    let rendered =
+        new_mcp_tools_output_from_statuses(&statuses, McpServerStatusDetail::ToolsAndAuthOnly)
+            .display_lines(/*width*/ 100)
+            .iter()
+            .map(ToString::to_string)
+            .collect::<Vec<_>>();
+    assert_eq!(
+        rendered,
+        vec![
+            "/mcp",
+            "",
+            "🔌  MCP Tools",
+            "",
+            "  • failing_local: failed (0 tools)",
+            "  • notes: connected (0 tools)",
+            "  • search: connected (0 tools)",
+            "",
+            "  Discovered on this network:",
+            "  • calendar_local: not connected",
+            "  • ietf-127-venue-guide_local: not connected",
+            "      http://venue-guide-mac.local:8127",
+            "",
+            "  Use /mcp verbose for tools and resources.",
+        ]
+    );
+}
