     PlainHistoryCell { lines }
 }
 
+/// zeroconf-agent-discovery: the ID of the discovery extension's MCP server
+/// contributor (`ZeroconfDiscovery::id` in `ext/zeroconf-discovery`).
+const DISCOVERY_EXTENSION_ID: &str = "zeroconf_discovery";
+
+/// zeroconf-agent-discovery: a server announced on the local network, which
+/// the discovery extension contributes disabled. Codex has not connected to
+/// it, so its tool count is unknown, not zero, and it is listed apart and
+/// without one. Once the user adds it with `codex mcp add`, it comes from the
+/// configuration instead and joins the normal list.
+fn is_discovered(status: &McpServerStatus) -> bool {
+    status.extension_id.as_deref() == Some(DISCOVERY_EXTENSION_ID)
+}
+
 /// Build the `/mcp` history cell from app-server `McpServerStatus` responses.
 ///
 /// The server list comes directly from the app-server status response, sorted
@@ -653,6 +668,9 @@ pub(crate) fn new_mcp_tools_output_from_statuses(
 
     let mut statuses = statuses.iter().collect::<Vec<_>>();
     statuses.sort_by(|a, b| a.name.cmp(&b.name));
+    let (discovered, statuses): (Vec<_>, Vec<_>) = statuses
+        .into_iter()
+        .partition(|status| is_discovered(status));
 
     let has_any_tools = statuses.iter().any(|status| !status.tools.is_empty());
     if !has_any_tools && matches!(detail, McpServerStatusDetail::Full) {
@@ -771,6 +789,33 @@ pub(crate) fn new_mcp_tools_output_from_statuses(
         lines.push(Line::from(""));
     }
 
+    // zeroconf-agent-discovery: servers announced on the local network,
+    // which Codex lists but has not connected to, as a sub-list of the
+    // servers above.
+    if !discovered.is_empty() {
+        if lines.last().is_some_and(|line| line.width() > 0) {
+            lines.push("".into());
+        }
+        lines.push("  Discovered on this network:".bold().into());
+        for status in discovered {
+            lines.push(
+                vec![
+                    "  • ".dim(),
+                    status.name.clone().bold(),
+                    ": ".into(),
+                    "not connected".dim(),
+                ]
+                .into(),
+            );
+            if let Some(origin) = &status.http_origin {
+                lines.push(format!("      {origin}").dim().into());
+            }
+        }
+        if matches!(detail, McpServerStatusDetail::Full) {
+            lines.push("".into());
+        }
+    }
+
     if matches!(detail, McpServerStatusDetail::ToolsAndAuthOnly) {
         lines.push("".into());
         lines.push("  Use /mcp verbose for tools and resources.".dim().into());
