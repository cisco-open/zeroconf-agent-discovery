From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lori Jakab <lojakab@cisco.com>
Date: Mon, 9 Nov 2026 14:37:39 +0100
Subject: [PATCH] Store MCP OAuth credentials in a file unless keyring is
 configured
Organization: Cisco Systems, Inc.

Copyright 2026 Cisco Systems, Inc. and its affiliates
SPDX-License-Identifier: Apache-2.0

Signed-off-by: Lori Jakab <lojakab@cisco.com>
---
 codex-rs/core/src/config/mod.rs | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/codex-rs/core/src/config/mod.rs b/codex-rs/core/src/config/mod.rs
index bf3d6e4..e17050b 100644
--- a/codex-rs/core/src/config/mod.rs
+++ b/codex-rs/core/src/config/mod.rs
@@ -309,6 +309,8 @@ fn resolve_mcp_oauth_credentials_store_mode(
             LOCAL_DEV_BUILD_VERSION,
             OAuthCredentialsStoreMode::Keyring | OAuthCredentialsStoreMode::Auto,
         ) => OAuthCredentialsStoreMode::File,
+        // zeroconf-agent-discovery: self-built, so the keychain asks again after every build.
+        (_, OAuthCredentialsStoreMode::Auto) => OAuthCredentialsStoreMode::File,
         (_, mode) => mode,
     }
 }
