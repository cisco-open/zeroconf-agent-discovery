+/// zeroconf-agent-discovery: the configuration entry for a discovered MCP
+/// server, `[mcp_servers.<name>]` with its URL, as `codex mcp add --url`
+/// writes it. Discovered names consist of letters, digits, `-` and `_`, so
+/// they need no quoting in the key path.
+pub(super) fn discovered_mcp_server_edit(name: &str, url: String) -> ConfigEdit {
+    ConfigEdit {
+        key_path: format!("mcp_servers.{name}"),
+        value: serde_json::json!({ "url": url }),
+        merge_strategy: MergeStrategy::Upsert,
+    }
+}
+
+async fn add_mcp_server_and_reload(
+    request_handle: AppServerRequestHandle,
+    name: &str,
+    url: String,
+) -> Result<()> {
+    let request_id = RequestId::String(format!("mcp-connect-write-{}", Uuid::new_v4()));
+    let _: ConfigWriteResponse = request_handle
+        .request_typed(ClientRequest::ConfigBatchWrite {
+            request_id,
+            params: ConfigBatchWriteParams {
+                edits: vec![discovered_mcp_server_edit(name, url)],
+                file_path: None,
+                expected_version: None,
+                reload_user_config: false,
+            },
+        })
+        .await
+        .wrap_err("config/batchWrite failed while adding an MCP server in TUI")?;
+    let request_id = RequestId::String(format!("mcp-connect-reload-{}", Uuid::new_v4()));
+    let _: McpServerRefreshResponse = request_handle
+        .request_typed(ClientRequest::McpServerRefresh {
+            request_id,
+            params: None,
+        })
+        .await
+        .wrap_err("config/mcpServer/reload failed in TUI")?;
+    Ok(())
+}
