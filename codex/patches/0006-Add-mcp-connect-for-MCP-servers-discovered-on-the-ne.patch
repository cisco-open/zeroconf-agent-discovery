+    /// zeroconf-agent-discovery: fetches the MCP servers for the `/mcp connect`
+    /// picker, which offers those discovered on the local network.
+    pub(super) fn fetch_mcp_connect_candidates(&self, app_server: &AppServerSession) {
+        let request_handle = app_server.request_handle();
+        let app_event_tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let result = fetch_all_mcp_server_statuses(
+                request_handle,
+                McpServerStatusDetail::ToolsAndAuthOnly,
+                /*thread_id*/ None,
+            )
+            .await
+            .map_err(|err| err.to_string());
+            app_event_tx.send(AppEvent::McpConnectPickerLoaded { result });
+        });
+    }
+
+    pub(super) fn handle_mcp_connect_candidates(
+        &mut self,
+        result: Result<Vec<McpServerStatus>, String>,
+    ) {
+        match result {
+            Ok(statuses) => self.chat_widget.open_mcp_connect_picker(&statuses),
+            Err(err) => self
+                .chat_widget
+                .add_error_message(format!("Failed to load MCP servers: {err}")),
+        }
+    }
+
+    /// zeroconf-agent-discovery: adds a discovered MCP server to the user's
+    /// configuration, as `codex mcp add` would, then reloads the MCP servers,
+    /// so that Codex connects to it. From then on, the server comes from the
+    /// configuration, and the discovery extension no longer contributes it.
+    pub(super) fn connect_discovered_mcp_server(
+        &self,
+        app_server: &AppServerSession,
+        name: String,
+        url: String,
+    ) {
+        let request_handle = app_server.request_handle();
+        let app_event_tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let result = add_mcp_server_and_reload(request_handle, &name, url)
+                .await
+                .map_err(|err| err.to_string());
+            app_event_tx.send(AppEvent::DiscoveredMcpServerConnected { name, result });
+        });
+    }
+
+    pub(super) fn handle_discovered_mcp_server_connected(
+        &mut self,
+        name: String,
+        result: Result<(), String>,
+    ) {
+        match result {
+            Ok(()) => {
+                self.chat_widget.add_info_message(
+                    format!("Added {name} to config.toml."),
+                    /*hint*/ Some("Codex connects to it now.".to_string()),
+                );
+                self.chat_widget
+                    .add_mcp_output(McpServerStatusDetail::ToolsAndAuthOnly);
+            }
+            Err(err) => self
+                .chat_widget
+                .add_error_message(format!("Failed to add {name}: {err}")),
+        }
+    }
