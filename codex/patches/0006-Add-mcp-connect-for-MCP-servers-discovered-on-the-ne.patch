+// Copyright 2026 Cisco Systems, Inc. and its affiliates
+// SPDX-License-Identifier: Apache-2.0
+
+//! zeroconf-agent-discovery: the `/mcp connect` picker, which connects to an
+//! MCP server discovered on the local network.
+
+use super::*;
+use crate::history_cell::is_discovered;
+use codex_app_server_protocol::McpServerStatus;
+
+impl ChatWidget {
+    /// Offers the servers discovered on the local network, with their URLs.
+    /// Choosing one adds it to the configuration, and Codex connects to it.
+    pub(crate) fn open_mcp_connect_picker(&mut self, statuses: &[McpServerStatus]) {
+        let mut candidates: Vec<(String, String)> = statuses
+            .iter()
+            .filter(|status| is_discovered(status))
+            .filter_map(|status| {
+                let url = status.extension_server_url.clone()?;
+                Some((status.name.clone(), url))
+            })
+            .collect();
+        if candidates.is_empty() {
+            self.add_info_message(
+                "No MCP servers discovered on this network.".to_string(),
+                /*hint*/ None,
+            );
+            return;
+        }
+        candidates.sort();
+
+        let items = candidates
+            .into_iter()
+            .map(|(name, url)| {
+                let action: SelectionAction = {
+                    let (name, url) = (name.clone(), url.clone());
+                    Box::new(move |tx| {
+                        tx.send(AppEvent::ConnectDiscoveredMcpServer {
+                            name: name.clone(),
+                            url: url.clone(),
+                        });
+                    })
+                };
+                SelectionItem {
+                    name,
+                    description: Some(url),
+                    actions: vec![action],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                }
+            })
+            .collect();
+        self.show_selection_view(SelectionViewParams {
+            title: Some("Connect to an MCP server on this network".to_string()),
+            subtitle: Some(
+                "Anyone on the network can announce a server; choosing one adds it to config.toml."
+                    .to_string(),
+            ),
+            footer_hint: Some(standard_popup_hint_line()),
+            items,
+            ..Default::default()
+        });
+    }
+}
