+//! zeroconf-agent-discovery: the `/mcp connect` picker.
+
+use super::*;
+use codex_app_server_protocol::McpAuthStatus;
+use codex_app_server_protocol::McpServerStatus;
+
+fn status(name: &str, extension_id: Option<&str>, url: Option<&str>) -> McpServerStatus {
+    McpServerStatus {
+        name: name.to_string(),
+        runtime_status: None,
+        plugin_id: None,
+        extension_id: extension_id.map(str::to_string),
+        extension_server_url: url.map(str::to_string),
+        http_origin: None,
+        server_info: None,
+        server_capabilities: None,
+        tool_list_meta: None,
+        tools: HashMap::new(),
+        tools_error: None,
+        resources: Vec::new(),
+        resource_templates: Vec::new(),
+        auth_status: McpAuthStatus::Unsupported,
+    }
+}
+
+#[tokio::test]
+async fn offers_only_discovered_servers_and_connects_to_the_chosen_one() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    let statuses = [
+        status("notes", None, None),
+        status(
+            "search",
+            Some("web_search"),
+            Some("https://search.example/mcp"),
+        ),
+        status(
+            "venue-guide_local",
+            Some("zeroconf_discovery"),
+            Some("http://venue-guide-mac.local:8127/mcp"),
+        ),
+        status(
+            "calendar_local",
+            Some("zeroconf_discovery"),
+            Some("https://room1.local:8443/mcp"),
+        ),
+    ];
+
+    chat.open_mcp_connect_picker(&statuses);
+
+    let popup = render_bottom_popup(&chat, /*width*/ 100);
+    assert!(popup.contains("Connect to an MCP server on this network"));
+    assert!(popup.contains("calendar_local"));
+    assert!(popup.contains("http://venue-guide-mac.local:8127/mcp"));
+    assert!(!popup.contains("notes"));
+    assert!(!popup.contains("search"));
+
+    // The list is in name order: the second entry is the venue guide.
+    chat.handle_key_event(KeyEvent::from(KeyCode::Down));
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+
+    assert_matches!(
+        rx.try_recv(),
+        Ok(AppEvent::ConnectDiscoveredMcpServer { name, url })
+            if name == "venue-guide_local" && url == "http://venue-guide-mac.local:8127/mcp"
+    );
+    assert!(chat.no_modal_or_popup_active());
+}
+
+#[tokio::test]
+async fn says_so_when_nothing_was_discovered() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+
+    chat.open_mcp_connect_picker(&[status("notes", None, None)]);
+
+    assert!(chat.no_modal_or_popup_active());
+    let rendered = drain_insert_history(&mut rx)
+        .iter()
+        .map(|lines| lines_to_single_string(lines))
+        .collect::<String>();
+    assert!(rendered.contains("No MCP servers discovered on this network."));
+}
