From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lori Jakab <lojakab@cisco.com>
Date: Mon, 9 Nov 2026 12:54:54 +0100
Subject: [PATCH] Mark the build as zeroconf-agent-discovery in --version and
 the TUI header
Organization: Cisco Systems, Inc.

Copyright 2026 Cisco Systems, Inc. and its affiliates
SPDX-License-Identifier: Apache-2.0

Signed-off-by: Lori Jakab <lojakab@cisco.com>
---
 codex-rs/cli/src/main.rs                 | 10 +++++++++-
 codex-rs/tui/src/history_cell/session.rs |  9 ++++++++-
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/codex-rs/cli/src/main.rs b/codex-rs/cli/src/main.rs
index 1c3fe17..904ef53 100644
--- a/codex-rs/cli/src/main.rs
+++ b/codex-rs/cli/src/main.rs
@@ -1,3 +1,5 @@
+// Modified by Cisco Systems, Inc. and its affiliates, 2026, for zeroconf-agent-discovery: https://github.com/cisco-open/zeroconf-agent-discovery
+
 use clap::Args;
 use clap::CommandFactory;
 use clap::Parser;
@@ -115,7 +117,13 @@ use codex_terminal_detection::TerminalName;
 #[derive(Debug, Parser)]
 #[clap(
     author,
-    version,
+    // zeroconf-agent-discovery: identify this as a modified build.
+    version = concat!(
+        env!("CARGO_PKG_VERSION"),
+        " (zeroconf-agent-discovery ",
+        env!("ZEROCONF_AGENT_DISCOVERY_COMMIT"),
+        ")"
+    ),
     // If a sub‑command is given, ignore requirements of the default args.
     subcommand_negates_reqs = true,
     // The executable is sometimes invoked via a platform‑specific name like
diff --git a/codex-rs/tui/src/history_cell/session.rs b/codex-rs/tui/src/history_cell/session.rs
index 120454d..916bb9b 100644
--- a/codex-rs/tui/src/history_cell/session.rs
+++ b/codex-rs/tui/src/history_cell/session.rs
@@ -1,3 +1,5 @@
+// Modified by Cisco Systems, Inc. and its affiliates, 2026, for zeroconf-agent-discovery: https://github.com/cisco-open/zeroconf-agent-discovery
+
 //! Session headers, onboarding guidance, and transcript cards.
 
 use super::*;
@@ -46,6 +48,8 @@ pub(crate) fn codex_title(version: &str) -> Vec<Span<'static>> {
         ">_ ".fg(accent_color()),
         "OpenAI Codex".bold(),
         format!(" (v{version})").dim(),
+        // zeroconf-agent-discovery: identify this as a modified build.
+        " · zeroconf-agent-discovery build".dim(),
     ]
 }
 
@@ -406,7 +410,10 @@ impl HistoryCell for SessionHeaderHistoryCell {
 
     fn raw_lines(&self) -> Vec<Line<'static>> {
         let mut lines = vec![
-            Line::from(format!("OpenAI Codex (v{})", self.version)),
+            Line::from(format!(
+                "OpenAI Codex (v{}) · zeroconf-agent-discovery build",
+                self.version
+            )),
             Line::from(format!(
                 "model: {}{}",
                 self.model,
